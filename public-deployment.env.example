# Matter Workbench public/private web deployment intake template.
#
# Copy this to a private file outside git, for example:
#   ~/.config/matter-workbench/<provider>-deployment.env
#
# Do not copy a filled version into the repository.
#
# This is a checklist, not one file that every process should load directly:
# - runtime.env on the server gets the app/runtime values.
# - mothership.env on the server gets the operator receiver values.
# - the operator Mac shell gets deploy/SSH/tester credentials when running checks.

# ---------------------------------------------------------------------------
# A. Values we decide/control
# ---------------------------------------------------------------------------

# Deployment identity.
MWB_DEPLOYMENT_NAME=matter-workbench-beta-1
MWB_DEPLOYMENT_PROVIDER=digitalocean
MWB_DEPLOYMENT_REGION=
MWB_PRIVATE_BETA_INSTALL_ID=matter-workbench-beta-1

# Public URL testers open.
# For real tester access this should be https://...
MWB_PRIVATE_BETA_PUBLIC_URL=https://mwb-beta.example.com
MWB_PUBLIC_URL=https://mwb-beta.example.com
MWB_PRIVATE_VM_BASE_URL=https://mwb-beta.example.com

# App listener. Usually kept behind nginx/Caddy on the VM.
PORT=4191
MWB_RUNTIME_HOST=0.0.0.0

# Private beta access.
MWB_PRIVATE_BETA_AUTH=required
MWB_PRIVATE_BETA_USERS_FILE=/home/aks/.config/matter-workbench/private-beta-users.json
MWB_PRIVATE_BETA_SESSION_TTL_SECONDS=28800
MWB_PRIVATE_BETA_COOKIE_SECURE=true

# Runtime DB custody. This is the app posture, not the migration/admin posture.
MWB_RUNTIME_DB=postgres
MWB_RUNTIME_DB_STORAGE=postgres
MWB_DB_RUNTIME_CUTOVER_APPROVED=yes

# Runtime files/ledgers that should survive deploys.
MWB_PRIVATE_BETA_FEEDBACK_PATH=/home/aks/.local/share/matter-workbench/private-beta-feedback-ledger.json
MWB_PRIVATE_BETA_SIGNAL_PATH=/home/aks/.local/share/matter-workbench/private-beta-signal-ledger.json
MWB_PRIVATE_BETA_METRICS_PATH=/home/aks/.local/share/matter-workbench/private-beta-metrics-ledger.json

# Mothership sender settings used by the app runtime.
# If mothership runs on the same VM, keep these loopback.
MWB_PRIVATE_BETA_FEEDBACK_SYNC_URL=http://127.0.0.1:4192/v1/feedback
MWB_PRIVATE_BETA_SIGNAL_SYNC_URL=http://127.0.0.1:4192/v1/signals
MWB_PRIVATE_BETA_METRICS_SYNC_URL=http://127.0.0.1:4192/v1/metrics
MWB_PRIVATE_BETA_TELEMETRY_MODE=firm_internal

# Operator honesty metrics. Keep unknown until a real drill proves them.
MWB_RESTORE_DRILL_STATUS=unknown
MWB_STORAGE_BACKUP_STATUS=unknown

# Browser/runtime support for server-side checks.
MWB_PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium-browser

# Copilot/source-backed model policy defaults.
COPILOT_ANSWER_PROVIDER=openrouter
OPENROUTER_COPILOT_ANSWER_MODEL=openai/gpt-4.1
SOURCE_BACKED_ANALYSIS_PROVIDER=openai-direct
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_ROUTER_MAX_OUTPUT_TOKENS=1200

# Case Timeline policy.
CREATE_LISTOFDATES_TWO_PASS_ENABLED=0
CREATE_LISTOFDATES_PASS1_PROVIDER=openai-direct
OPENAI_CREATE_LISTOFDATES_PASS1_MODEL=gpt-4.1
OPENAI_CREATE_LISTOFDATES_PASS1_MAX_OUTPUT_TOKENS=9000
OPENAI_CREATE_LISTOFDATES_PASS1_TIMEOUT_MS=120000
CREATE_LISTOFDATES_PASS2_PROVIDER=openai-direct
OPENAI_CREATE_LISTOFDATES_PASS2_MODEL=gpt-5.4-mini
OPENAI_CREATE_LISTOFDATES_PASS2_MAX_OUTPUT_TOKENS=9000
OPENAI_CREATE_LISTOFDATES_PASS2_TIMEOUT_MS=120000

# Source labels / source-backed analysis defaults.
OPENROUTER_SOURCE_DESCRIPTION_MODEL=
OPENROUTER_SOURCE_DESCRIPTION_MAX_OUTPUT_TOKENS=3000
OPENROUTER_SOURCE_DESCRIPTION_TIMEOUT_MS=90000
OPENROUTER_SOURCE_DESCRIPTION_PROVIDER_ORDER=
OPENROUTER_SOURCE_DESCRIPTION_PROVIDER_SORT=
OPENROUTER_SOURCE_BACKED_ANALYSIS_MODEL=
OPENROUTER_SOURCE_BACKED_ANALYSIS_MAX_OUTPUT_TOKENS=3000
OPENROUTER_SOURCE_BACKED_ANALYSIS_TIMEOUT_MS=90000
OPENROUTER_SOURCE_BACKED_ANALYSIS_PROVIDER_SORT=latency

# Skill interview planner.
SKILL_INTERVIEW_PLANNER_ENABLED=1
SKILL_INTERVIEW_PLANNER_PROVIDER=openai-direct
OPENAI_SKILL_INTERVIEW_PLANNER_MODEL=gpt-5.4
OPENAI_SKILL_INTERVIEW_PLANNER_MAX_OUTPUT_TOKENS=2600
OPENAI_SKILL_INTERVIEW_PLANNER_TIMEOUT_MS=90000

# OCR posture for beta. Accuracy first.
MISTRAL_OCR_ENABLED=1
GEMINI_OCR_REPAIR_ENABLED=1
GEMINI_OCR_REPAIR_MODEL=gemini-2.5-pro
GEMINI_OCR_REPAIR_FAST_MODEL=gemini-2.5-flash-lite
OCR_REPAIR_MODE=accuracy
EXTRACT_CONCURRENCY=3

# ---------------------------------------------------------------------------
# B. Values supplied by vendors, infrastructure, or generated by provisioning
# ---------------------------------------------------------------------------

# Cloud VM identity from the infrastructure vendor.
MWB_CLOUD_PUBLIC_IP=
MWB_CLOUD_PRIVATE_IP=
MWB_CLOUD_SIZE=
MWB_CLOUD_BACKUPS_ENABLED=true

# Domain/DNS values from the domain/DNS provider.
MWB_DOMAIN_NAME=
MWB_DNS_A_RECORD_TARGET=
MWB_TLS_EMAIL=

# SSH/deploy operator values. These normally live only on the operator machine.
MWB_PRIVATE_VM_HOST=
MWB_PRIVATE_VM_USER=aks
MWB_PRIVATE_VM_DEPLOYMENT_ROOT=/home/aks/matter-workbench-deployments
MWB_PRIVATE_VM_SSH_IDENTITY=~/.ssh/matter_workbench_vm_ed25519

# Runtime DB URL from provisioning.
# Must be a restricted runtime role: not superuser, not createdb, not createrole,
# not bypassrls. Use a separate admin URL only for controlled migration/backup
# commands if needed.
MWB_RUNTIME_DATABASE_URL=postgres://mwb_runtime:<password>@127.0.0.1:5432/matter_workbench_runtime
MWB_DATABASE_URL=postgres://mwb_runtime:<password>@127.0.0.1:5432/matter_workbench_runtime

# V4 runtime.env values. Keep MWB_V4_INTAKE absent until readiness passes; do not
# place the admin or migration URLs in runtime.env.
# MWB_V4_INTAKE=1
MWB_V4_DB_URL=postgres://mwb_v4_runtime:<runtime-password>@127.0.0.1:5432/matter_workbench_v4
MWB_V4_DB_POOL_MAX=16
MWB_V4_AUTO_MIGRATE=0

# V4 operator-only values. Store these in a separate mode-0600 file that systemd
# never loads. The migration owner has BYPASSRLS only so backup and verification
# can read tables that force RLS; it remains non-superuser/no-createdb/no-createrole.
MWB_V4_ADMIN_URL=postgres://<authorized-admin>:<password>@127.0.0.1:5432/postgres
MWB_V4_MIGRATION_URL=postgres://mwb_v4_migrator:<migration-password>@127.0.0.1:5432/matter_workbench_v4
MWB_V4_MIGRATION_ROLE=mwb_v4_migrator
MWB_V4_RUNTIME_ROLE=mwb_v4_runtime
MWB_V4_PG_HBA_FILE=/etc/postgresql/16/main/pg_hba.conf
# Pin matching server-major clients when more than one PostgreSQL version exists.
MWB_PG_DUMP_BIN=/usr/lib/postgresql/16/bin/pg_dump
MWB_PSQL_BIN=/usr/lib/postgresql/16/bin/psql

# Mothership receiver env. Put these in mothership.env, not runtime.env.
MOTHERSHIP_HOST=127.0.0.1
MOTHERSHIP_PORT=4192
MOTHERSHIP_DATABASE_URL=postgres://mwb_mothership:<password>@127.0.0.1:5432/matter_workbench_mothership

# Mothership ingestion token generated by:
#   npm run mothership:operator -- installations create --id <install-id> --label <label>
#
# Put the same token into the runtime sender variables below.
MWB_PRIVATE_BETA_FEEDBACK_SYNC_TOKEN=mwb_ing_<generated-token>
MWB_PRIVATE_BETA_SIGNAL_SYNC_TOKEN=mwb_ing_<generated-token>
MWB_PRIVATE_BETA_METRICS_SYNC_TOKEN=mwb_ing_<generated-token>

# Private beta operator/tester credentials.
# Prefer MWB_PRIVATE_BETA_USERS_FILE for real testers. Keep these only in the
# operator shell for service checks and handoff drills.
MWB_PRIVATE_BETA_USERNAME=
MWB_PRIVATE_BETA_PASSWORD=

# AI/provider keys from vendors.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
PARALLEL_API_KEY=

# Optional provider controls from vendors or cost policy.
OPENROUTER_SOURCE_BACKED_ANALYSIS_PROVIDER_ORDER=
OPENROUTER_SOURCE_BACKED_ANALYSIS_MAX_PROMPT_PRICE=
OPENROUTER_SOURCE_BACKED_ANALYSIS_MAX_COMPLETION_PRICE=
OPENROUTER_SOURCE_DESCRIPTION_MAX_PROMPT_PRICE=
OPENROUTER_SOURCE_DESCRIPTION_MAX_COMPLETION_PRICE=
GEMINI_OCR_TIMEOUT_MS=180000
GEMINI_OCR_THINKING_LEVEL=
PARALLEL_LEGAL_UPDATES_ENABLED=1
PARALLEL_LEGAL_UPDATES_MAX_ITEMS=20
PARALLEL_LEGAL_UPDATES_CACHE_MINUTES=60

# ---------------------------------------------------------------------------
# C. Readiness checks to run after filling real values
# ---------------------------------------------------------------------------

# On the server after deployment:
#   npm run db:migrate
#   npm run mothership:migrate
#   npm run db:runtime:write-smoke -- --out-dir /tmp/mwb-runtime-write-smoke
#
# On the operator machine or server shell with test credentials loaded:
#   npm run private-web:readiness-check
#   npm run private-vm:service-check -- --base-url "$MWB_PRIVATE_BETA_PUBLIC_URL"
#   npm run mothership:report
