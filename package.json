{
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "ui:dev": "vite --config react-ui/vite.config.ts --host 127.0.0.1",
    "ui:typecheck": "tsc -b react-ui/tsconfig.json",
    "ui:build": "npm run ui:typecheck && vite build --config react-ui/vite.config.ts",
    "ui:smoke": "node scripts/react-ui-smoke.mjs",
    "matter-init:dry-run": "node matter-init-engine.mjs",
    "matter-init": "node matter-init-engine.mjs --apply",
    "extract:dry-run": "node extract-engine.mjs",
    "extract": "node extract-engine.mjs --apply",
    "matter-attention:report": "node scripts/matter-attention-report.mjs",
    "v1-beta:mode-a-reset": "node scripts/v1-beta-mode-a-reset.mjs",
    "v1-beta:mode-a-acceptance": "node scripts/v1-beta-mode-a-acceptance.mjs",
    "create-listofdates:dry-run": "node create-listofdates-engine.mjs",
    "create-listofdates": "node create-listofdates-engine.mjs --apply"
