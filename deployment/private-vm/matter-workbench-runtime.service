[Unit]
Description=Matter Workbench private runtime DB service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/matter-workbench-deployments/current/app
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/matter-workbench/runtime.env
ExecStart=/usr/bin/env node scripts/start-runtime-server.mjs --host 127.0.0.1 --port 4191
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
