# Copy to ~/.config/matter-workbench/mothership.env on the VM and chmod 600.
# Keep the receiver loopback-only. The workbench service on the same VM sends to it.
MOTHERSHIP_HOST=127.0.0.1
MOTHERSHIP_PORT=4192
MOTHERSHIP_DATABASE_URL=postgres://<restricted-user>:<password>@127.0.0.1:5432/matter_workbench_mothership

# Operator console (dashboard). Enable to require a login for /api/* reads.
MOTHERSHIP_CONSOLE=required
MOTHERSHIP_CONSOLE_SESSION_TTL_SECONDS=28800

# Recommended two-person access mode: email code via Resend.
MOTHERSHIP_CONSOLE_AUTH_MODE=email_code
MOTHERSHIP_CONSOLE_ALLOWED_EMAILS=aks@example.com,hemanth@example.com
MOTHERSHIP_CONSOLE_EMAIL_PROVIDER=resend
# Prefer a console-scoped key; RESEND_API_KEY is also accepted.
MOTHERSHIP_CONSOLE_EMAIL_API_KEY=re_<resend-key>
MOTHERSHIP_CONSOLE_FROM_EMAIL="Matter Workbench <mothership@example.com>"
MOTHERSHIP_CONSOLE_CODE_TTL_SECONDS=600

# Legacy/shared-password mode, if needed instead of email_code:
# Generate the hash with: node -e "import('./mothership/console-auth.mjs').then(m=>console.log(m.hashConsolePassword(process.argv[1])))" 'your-password'
# MOTHERSHIP_CONSOLE_AUTH_MODE=password
# MOTHERSHIP_CONSOLE_USERNAME=aks_hemanth
# MOTHERSHIP_CONSOLE_PASSWORD_HASH=pbkdf2-sha256$210000$<saltB64url>$<hashB64url>

# Set to the public https origin so the session cookie gets the Secure flag:
# MOTHERSHIP_CONSOLE_PUBLIC_URL=https://mothership.example.com
# Optional: override the built console asset dir (defaults to mothership/console/dist):
# MOTHERSHIP_CONSOLE_ASSET_ROOT=/opt/matter-workbench/mothership-console-dist
