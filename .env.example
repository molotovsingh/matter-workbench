# Matter Workbench local configuration.
# Copy to .env and fill only the providers you intentionally use.

# Optional server settings.
PORT=4173
MATTERS_HOME=
MATTER_ROOT=

# Private beta access gate. Leave off for ordinary local development.
# Set to required on the private VM and store the real password only in the
# protected runtime env file, never in git.
MWB_PRIVATE_BETA_AUTH=off
MWB_PRIVATE_BETA_USERNAME=
MWB_PRIVATE_BETA_PASSWORD=
MWB_PRIVATE_BETA_SESSION_TTL_SECONDS=28800
MWB_PRIVATE_BETA_SESSIONS_FILE=

# OpenAI direct is the default provider for the skill router and
# /create_listofdates unless task-specific provider flags choose OpenRouter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_ROUTER_MAX_OUTPUT_TOKENS=1200

# Skill-router provider selection for command-box intent checks.
# Set to openrouter to route free-form command checks through OpenRouter.
SKILL_ROUTER_PROVIDER=openai-direct
OPENROUTER_SKILL_ROUTER_MODEL=openai/gpt-5.4-mini
OPENROUTER_SKILL_ROUTER_MAX_OUTPUT_TOKENS=1200
OPENROUTER_SKILL_ROUTER_TIMEOUT_MS=30000

# Matter Copilot transient answer routing.
COPILOT_ANSWER_PROVIDER=openrouter
OPENAI_COPILOT_ANSWER_MODEL=gpt-5.4
OPENROUTER_COPILOT_ANSWER_MODEL=openai/gpt-5.4
OPENROUTER_COPILOT_ANSWER_MAX_OUTPUT_TOKENS=2200
OPENROUTER_COPILOT_ANSWER_TIMEOUT_MS=90000

# Copilot Research mode is planned/disabled by default.
# When enabled, Research uses public web/legal sources plus matter context.
COPILOT_WEB_RESEARCH_ENABLED=0
COPILOT_WEB_RESEARCH_PROVIDER=exa
EXA_API_KEY=
COPILOT_WEB_RESEARCH_MAX_RESULTS=6
COPILOT_WEB_RESEARCH_TIMEOUT_MS=20000
COPILOT_WEB_RESEARCH_MAX_RESULT_CHARS=9000
COPILOT_WEB_RESEARCH_ANSWER_PROVIDER=openrouter
OPENAI_COPILOT_WEB_RESEARCH_ANSWER_MODEL=gpt-5.4
OPENROUTER_COPILOT_WEB_RESEARCH_ANSWER_MODEL=openai/gpt-5.4
OPENROUTER_COPILOT_WEB_RESEARCH_ANSWER_MAX_OUTPUT_TOKENS=3600
OPENROUTER_COPILOT_WEB_RESEARCH_ANSWER_TIMEOUT_MS=120000

# Compact Ask/Research improvement receipts. Local/private-beta ledger only.
MWB_COPILOT_INTERACTION_RECEIPTS_PATH=

# /create_listofdates provider selection.
# Leave as openai-direct for the default OpenAI Responses API path.
# Set to openrouter only when you want chronology generation through OpenRouter.
SOURCE_BACKED_ANALYSIS_PROVIDER=openai-direct
OPENROUTER_API_KEY=
OPENROUTER_SOURCE_BACKED_ANALYSIS_MODEL=
OPENROUTER_SOURCE_BACKED_ANALYSIS_MAX_OUTPUT_TOKENS=3000
OPENROUTER_SOURCE_BACKED_ANALYSIS_TIMEOUT_MS=90000
OPENROUTER_SOURCE_BACKED_ANALYSIS_PROVIDER_ORDER=
OPENROUTER_SOURCE_BACKED_ANALYSIS_PROVIDER_SORT=latency
OPENROUTER_SOURCE_BACKED_ANALYSIS_MAX_PROMPT_PRICE=
OPENROUTER_SOURCE_BACKED_ANALYSIS_MAX_COMPLETION_PRICE=

# Optional two-pass /create_listofdates runtime. Off by default.
# When enabled, pass 1 writes an internal candidate ledger and pass 2 writes
# the normal List of Dates artifacts only after validation.
CREATE_LISTOFDATES_TWO_PASS_ENABLED=0
CREATE_LISTOFDATES_PASS1_PROVIDER=openai-direct
OPENAI_CREATE_LISTOFDATES_PASS1_MODEL=gpt-4.1
OPENAI_CREATE_LISTOFDATES_PASS1_MAX_OUTPUT_TOKENS=9000
OPENAI_CREATE_LISTOFDATES_PASS1_TIMEOUT_MS=120000
CREATE_LISTOFDATES_PASS2_PROVIDER=openai-direct
OPENAI_CREATE_LISTOFDATES_PASS2_MODEL=gpt-5.4-mini
OPENAI_CREATE_LISTOFDATES_PASS2_MAX_OUTPUT_TOKENS=9000
OPENAI_CREATE_LISTOFDATES_PASS2_TIMEOUT_MS=120000
OPENROUTER_CREATE_LISTOFDATES_PASS1_MODEL=
OPENROUTER_CREATE_LISTOFDATES_PASS1_MAX_OUTPUT_TOKENS=9000
OPENROUTER_CREATE_LISTOFDATES_PASS1_TIMEOUT_MS=120000
OPENROUTER_CREATE_LISTOFDATES_PASS1_PROVIDER_ORDER=
OPENROUTER_CREATE_LISTOFDATES_PASS1_PROVIDER_SORT=
OPENROUTER_CREATE_LISTOFDATES_PASS1_MAX_PROMPT_PRICE=
OPENROUTER_CREATE_LISTOFDATES_PASS1_MAX_COMPLETION_PRICE=
OPENROUTER_CREATE_LISTOFDATES_PASS2_MODEL=
OPENROUTER_CREATE_LISTOFDATES_PASS2_MAX_OUTPUT_TOKENS=9000
OPENROUTER_CREATE_LISTOFDATES_PASS2_TIMEOUT_MS=120000
OPENROUTER_CREATE_LISTOFDATES_PASS2_PROVIDER_ORDER=
OPENROUTER_CREATE_LISTOFDATES_PASS2_PROVIDER_SORT=
OPENROUTER_CREATE_LISTOFDATES_PASS2_MAX_PROMPT_PRICE=
OPENROUTER_CREATE_LISTOFDATES_PASS2_MAX_COMPLETION_PRICE=

# /describe_sources uses OpenRouter and writes Source Index.json labels.
# Source labels are quality-first because downstream legal artifacts depend on them.
OPENROUTER_SOURCE_DESCRIPTION_MODEL=openai/gpt-4.1
OPENROUTER_SOURCE_DESCRIPTION_FALLBACK_MODEL=google/gemini-2.5-pro
OPENROUTER_SOURCE_DESCRIPTION_MAX_OUTPUT_TOKENS=6000
OPENROUTER_SOURCE_DESCRIPTION_TIMEOUT_MS=240000
OPENROUTER_SOURCE_DESCRIPTION_PROVIDER_ORDER=
OPENROUTER_SOURCE_DESCRIPTION_PROVIDER_SORT=latency
OPENROUTER_SOURCE_DESCRIPTION_MAX_PROMPT_PRICE=
OPENROUTER_SOURCE_DESCRIPTION_MAX_COMPLETION_PRICE=

# Experimental skill idea interview planner.
# Disabled by default; when enabled, it only plans interview questions and
# must not generate runnable skills, prompts, code, or matter artifacts.
SKILL_INTERVIEW_PLANNER_ENABLED=0
SKILL_INTERVIEW_PLANNER_PROVIDER=openai-direct
OPENAI_SKILL_INTERVIEW_PLANNER_MODEL=gpt-5.4
OPENAI_SKILL_INTERVIEW_PLANNER_MAX_OUTPUT_TOKENS=2600
OPENAI_SKILL_INTERVIEW_PLANNER_TIMEOUT_MS=90000
OPENROUTER_SKILL_INTERVIEW_PLANNER_MODEL=
OPENROUTER_SKILL_INTERVIEW_PLANNER_MAX_OUTPUT_TOKENS=2600
OPENROUTER_SKILL_INTERVIEW_PLANNER_TIMEOUT_MS=90000

# OCR is opt-in. /extract uses Mistral first when the explicit gate is enabled.
# Gemini repair is optional and only runs when the Mistral result fails or scores weak.
MISTRAL_API_KEY=
MISTRAL_OCR_ENABLED=0
EXTRACT_CONCURRENCY=3
GEMINI_OCR_REPAIR_ENABLED=0
GEMINI_OCR_REPAIR_MODEL=gemini-2.5-pro
GEMINI_OCR_REPAIR_FAST_MODEL=gemini-2.5-flash-lite
OCR_REPAIR_MODE=accuracy

# Experimental OCR bakeoff and optional repair provider.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_OCR_MODELS=gemini-3.5-flash,gemini-3.1-pro-preview,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_OCR_TIMEOUT_MS=180000
GEMINI_OCR_THINKING_LEVEL=
